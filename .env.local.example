# Base URL of learna-api. No trailing slash — the client appends /api/v1.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Public origin of this app, used for canonical and Open Graph URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shown in the header, page titles and the footer.
NEXT_PUBLIC_SITE_NAME=Learna
